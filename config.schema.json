{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Home Control",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "window", "lights"],
  "properties": {
    "version": { "const": 1 },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "margin", "hideOnBlur"],
      "properties": {
        "width": { "type": "integer", "minimum": 280, "maximum": 480 },
        "margin": { "type": "integer", "minimum": 0, "maximum": 32 },
        "hideOnBlur": { "type": "boolean" }
      }
    },
    "lights": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "icon"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$",
            "description": "Identifiant unique et stable. Ne pas changer après appairage."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "icon": { "enum": ["bulb", "bed", "sofa", "kitchen", "desk", "sun"] }
        }
      }
    }
  }
}
