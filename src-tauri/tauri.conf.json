{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Home Control",
  "version": "0.2.0",
  "identifier": "fr.lorkydey.homecontrol",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Home Control",
        "width": 320,
        "height": 210,
        "minWidth": 280,
        "minHeight": 120,
        "resizable": false,
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "resources": {
      "resources/node.exe": "engine/node.exe",
      "../engine/dist/": "engine/"
    },
    "windows": {
      "nsis": { "displayLanguageSelector": false, "languages": ["French"] }
    }
  }
}
